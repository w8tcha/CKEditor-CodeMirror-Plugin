{
  "name": "ckeditor-codemirror-plugin",
  "version": "1.18.13",
  "author": "w8tcha",
  "description": "Syntax Highlighting for the CKEditor (Source View and Source Dialog) with the CodeMirror Plugin.",
  "repository": {
    "type": "git",
    "url": "https://github.com/w8tcha/CKEditor-CodeMirror-Plugin.git"
  },
  "keywords": [
    "CKEditor",
    "CodeMirror"
  ],
  "devDependencies": {
    "codemirror": "^5.65.21",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "js-beautify": "^2.0.3",
    "mini-css-extract-plugin": "^2.9.2",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.111.0",
    "webpack-cli": "^7.2.3"
  },
  "scripts": {
    "update-deps": "set npm_config_allow_scripts=&& npm-check -y -ignore ['codemirror']",
    "build": "webpack",
    "watch": "webpack --watch"
  }
}
